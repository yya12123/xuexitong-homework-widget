<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="12" Background="Transparent"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType">
  <Grid.Resources>
    <Style x:Key="IconButton" TargetType="Border">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#14FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MenuRow" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#12FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="7"/>
      <Setter Property="MinWidth" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent" Width="7">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#55FFFFFF" CornerRadius="3" Margin="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ItemTemplate">
      <Border x:Name="Row" CornerRadius="10" Padding="10,7" Margin="0,1" Background="Transparent" Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding RankText}" FontFamily="Consolas" FontSize="10.5" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Width="3" Height="26" CornerRadius="1.5" Background="{Binding AccentBrush}" VerticalAlignment="Center" Opacity="0.95"/>
          <StackPanel Grid.Column="2" Margin="10,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock Text="{Binding SubText}" FontSize="9.5" Foreground="#66FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold" Foreground="#F2FFFFFF" VerticalAlignment="Center" Margin="6,0,2,0"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="#12FFFFFF"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Grid.Resources>

  <Border x:Name="ShadowCard" CornerRadius="18" Background="#FF000000" Opacity="0.35">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.7" Color="#000000"/>
    </Border.Effect>
  </Border>

  <Border x:Name="Card" CornerRadius="18" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9141822" Offset="0"/>
        <GradientStop Color="#D50C0F16" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <SolidColorBrush Color="#2BFFFFFF"/>
    </Border.BorderBrush>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="66"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="36"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="18,4,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="HeaderDrag" VerticalAlignment="Center" Background="Transparent">
          <StackPanel Orientation="Horizontal">
            <Border Width="8" Height="8" CornerRadius="4" Background="#FFD166" VerticalAlignment="Center" Margin="0,0,8,1"/>
            <TextBlock Text="学习通作业" FontSize="14.5" FontWeight="SemiBold" Foreground="#F5FFFFFF"/>
          </StackPanel>
          <TextBlock x:Name="Subtitle" Text="正在同步..." FontSize="10.5" Foreground="#8CFFFFFF" Margin="16,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="BtnRefresh" Style="{StaticResource IconButton}" ToolTip="立即刷新">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border x:Name="BtnMenu" Style="{StaticResource IconButton}" ToolTip="设置">
            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border x:Name="BtnClose" Style="{StaticResource IconButton}" ToolTip="关闭">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>

      <Border x:Name="ErrorBar" Grid.Row="1" Margin="14,0,14,8" Padding="10,7" CornerRadius="8" Background="#26FF5C5C" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ErrorText" FontSize="10.5" Foreground="#FFFFB4B4" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Border x:Name="BtnRetry" Grid.Column="1" CornerRadius="6" Background="#26FFFFFF" Padding="9,4" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center">
            <TextBlock Text="重试" FontSize="10" Foreground="#FFFFDADA"/>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,5,0" Focusable="False" Background="Transparent" BorderThickness="0" CanContentScroll="False">
          <ItemsControl x:Name="List" ItemTemplate="{StaticResource ItemTemplate}" Margin="0,0,3,0"/>
        </ScrollViewer>
        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyTitle" Text="暂无待完成作业" FontSize="12.5" Foreground="#80FFFFFF" Margin="0,10,0,0" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyHint" Text="已同步 0 门课程" FontSize="9.5" Foreground="#4DFFFFFF" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="3" Height="1" VerticalAlignment="Top" Background="#0FFFFFFF"/>
      <Grid Grid.Row="3" Margin="18,0,14,0">
        <TextBlock x:Name="FooterLeft" FontSize="9.5" Foreground="#59FFFFFF" VerticalAlignment="Center" Text="尚未同步"/>
        <TextBlock x:Name="FooterRight" HorizontalAlignment="Right" FontSize="9.5" Foreground="#59FFFFFF" VerticalAlignment="Center" Text="60 分钟刷新"/>
      </Grid>

      <Border x:Name="MenuPanel" Grid.RowSpan="4" CornerRadius="17" Background="#F70A0D13" Visibility="Collapsed" Margin="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,15,20,14">
          <Grid>
            <TextBlock Text="快捷设置" FontSize="14" FontWeight="SemiBold" Foreground="#F5FFFFFF" VerticalAlignment="Center"/>
            <Border x:Name="MenuClose" Width="26" Height="26" CornerRadius="7" HorizontalAlignment="Right" Background="Transparent" Cursor="Hand">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>

          <TextBlock Text="刷新间隔" FontSize="10.5" Foreground="#66FFFFFF" Margin="0,15,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Chip30" Style="{StaticResource Chip}">
              <TextBlock Text="30 分钟" FontSize="10.5" Foreground="#E6FFFFFF"/>
            </Border>
            <Border x:Name="Chip60" Style="{StaticResource Chip}">
              <TextBlock Text="60 分钟" FontSize="10.5" Foreground="#E6FFFFFF"/>
            </Border>
            <Border x:Name="Chip120" Style="{StaticResource Chip}">
              <TextBlock Text="120 分钟" FontSize="10.5" Foreground="#E6FFFFFF"/>
            </Border>
          </StackPanel>

          <Border Height="1" Background="#0FFFFFFF" Margin="0,15,0,8"/>

          <Grid Margin="0,0,0,7">
            <StackPanel>
              <TextBlock Text="显示已截止作业" FontSize="11.5" Foreground="#E6FFFFFF"/>
              <TextBlock Text="只列出所选范围内截止的作业" FontSize="9.5" Foreground="#59FFFFFF" Margin="0,3,0,0"/>
            </StackPanel>
            <Border x:Name="ToggleOverdue" Width="40" Height="22" CornerRadius="11" Background="#24FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
              <Ellipse Width="16" Height="16" Fill="#F2FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
          </Grid>

          <StackPanel x:Name="OverdueRangePanel" Orientation="Horizontal" Margin="0,-2,0,9" Visibility="Collapsed">
            <Border x:Name="Chip7d" Style="{StaticResource Chip}">
              <TextBlock Text="近 7 天" FontSize="10.5" Foreground="#E6FFFFFF"/>
            </Border>
            <Border x:Name="Chip30d" Style="{StaticResource Chip}">
              <TextBlock Text="近 1 个月" FontSize="10.5" Foreground="#E6FFFFFF"/>
            </Border>
          </StackPanel>

          <Grid Margin="0,10,0,10">
            <StackPanel>
              <TextBlock Text="显示待批阅作业" FontSize="11.5" Foreground="#E6FFFFFF"/>
              <TextBlock Text="已提交、未批阅，且还没截止的作业" FontSize="9.5" Foreground="#59FFFFFF" Margin="0,3,0,0"/>
            </StackPanel>
            <Border x:Name="TogglePending" Width="40" Height="22" CornerRadius="11" Background="#24FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
              <Ellipse Width="16" Height="16" Fill="#F2FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
          </Grid>

          <Grid Margin="0,10,0,10">
            <StackPanel>
              <TextBlock Text="开机自动启动" FontSize="11.5" Foreground="#E6FFFFFF"/>
              <TextBlock Text="登录 Windows 后自动显示在右下角" FontSize="9.5" Foreground="#59FFFFFF" Margin="0,3,0,0"/>
            </StackPanel>
            <Border x:Name="ToggleAutoStart" Width="40" Height="22" CornerRadius="11" Background="#24FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
              <Ellipse Width="16" Height="16" Fill="#F2FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
          </Grid>

          <Border Height="1" Background="#0FFFFFFF" Margin="0,2,0,8"/>

          <Border x:Name="BtnAccount" Style="{StaticResource MenuRow}">
            <Grid>
              <StackPanel>
                <TextBlock Text="账号与密码" FontSize="11.5" Foreground="#E6FFFFFF"/>
                <TextBlock x:Name="AccountLabel" Text="未配置" FontSize="9.5" Foreground="#59FFFFFF" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border x:Name="BtnRefreshNow" Style="{StaticResource MenuRow}">
            <Grid>
              <TextBlock Text="立即刷新" FontSize="11.5" Foreground="#E6FFFFFF" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border x:Name="BtnQuit" Style="{StaticResource MenuRow}">
            <Grid>
              <TextBlock Text="退出程序" FontSize="11.5" Foreground="#FFFFA0A0" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <TextBlock Text="设置会自动保存" FontSize="9" Foreground="#40FFFFFF" Margin="2,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</Grid>
